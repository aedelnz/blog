---
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

const post = Astro.props;
const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} {...post.data}>
  <div class="vertical-list vertical-list-split w-full overflow-x-hidden">
    <div class="vertical-spin">
      <div class="vertical-spin-children w-full">
        <ul class="vertical-list-items w-full space-y-4">
          {posts.map((post) => (
            <li class="rounded-xl bg-sky-50 shadow-lg overflow-hidden w-full flex flex-col sm:flex-row transition-all duration-300 hover:shadow-xl hover:-translate-y-1 cursor-pointer">

              <a href={`/posts/${post.id}`} class="flex flex-col sm:flex-row w-full">
                <div class="w-full sm:w-2/5 aspect-[4/3] sm:aspect-auto flex-shrink-0 bg-gray-100">
                  {post.data.heroImage ? (
                    <Image src={post.data.heroImage} class="w-full h-full object-fill sm:object-cover rounded-t-lg sm:rounded-t-none sm:rounded-l-lg transition-transform duration-500 hover:scale-105" alt={post.data.title}/>
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-2xl text-gray-500 font-bold">暂无封面</div>
                  )}
                </div>
                <div class="flex-1 p-4">
                  <div class="flex mb-center items-center">
                    <span role="img" aria-label="activity" class="semi-icon semi-icon-search"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" focusable="false" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 1a1.5 1.5 0 0 0 0 3 8 8 0 1 1-4.75 14.44 1.5 1.5 0 1 0-1.79 2.4A11 11 0 1 0 12 1ZM7.5 5.2a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM5.5 7a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm-3 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM5 16.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm8.5-9a1.5 1.5 0 0 0-3 0V12c0 .4.16.78.44 1.06l3 3a1.5 1.5 0 0 0 2.12-2.12l-2.56-2.56V7.5Z" fill="currentColor"></path></svg></span>
                    <span class="text-gray-500 font-mono font-bold ml-2">{post.data.pubDate ? <FormattedDate date={post.data.pubDate} /> : '未知日期'}</span>
                  </div>
                  
                  <h3 class="text-lg font-bold mb-2 leading-tight line-clamp-2 hover:text-blue-600 transition-colors duration-200">{post.data.title}</h3>
                  <p class="text-gray-600 font-mono leading-relaxed line-clamp-3">{post.data.description || '暂无简介'}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Layout>