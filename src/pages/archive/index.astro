---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <BaseHead title={`归档 - ${SITE_TITLE}`} />
</head>
<body>
  <Header />
  <main>
    <h1 class="semi-typography semi-typography-primary semi-typography-normal semi-typography-h1">归档</h1>
	<ul class="semi-timeline semi-timeline-left">
      {posts.map(post => (
		<li class="semi-timeline-item semi-typography semi-typography-normal semi-typography-link semi-timeline-item-left">
			<div class="semi-timeline-item-tail" aria-hidden="true"></div>
			<div class="semi-timeline-item-head semi-timeline-item-head-default" aria-hidden="true"></div>
			<a href={`/posts/${post.id}`} class="semi-typography-link-text">
			<div class="semi-timeline-item-content">
			    {post.data.title}
			    <div class="semi-timeline-item-content-time"><FormattedDate date={post.data.pubDate} /></div>
			</div>
			</a>
		</li>
      ))}
	</ul>
    {posts.length === 0 && <p>暂无文章</p>}
  </main>
  <Footer />
</body>
</html>
