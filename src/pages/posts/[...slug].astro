---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { Content } = await render(post);
---

<Layout {...post.data}>
	<div class="bg-white rounded-3xl shadow-lg overflow-hidden">
		{post.data.heroImage && <Image src={post.data.heroImage} class="h-50 w-full object-cover" alt={post.data.title} />}
		<div class="p-4">
			                  <div class="flex mb-center items-center">
                    <span role="img" aria-label="activity" class="semi-icon semi-icon-search"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" focusable="false" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 1a1.5 1.5 0 0 0 0 3 8 8 0 1 1-4.75 14.44 1.5 1.5 0 1 0-1.79 2.4A11 11 0 1 0 12 1ZM7.5 5.2a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM5.5 7a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm-3 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM5 16.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm8.5-9a1.5 1.5 0 0 0-3 0V12c0 .4.16.78.44 1.06l3 3a1.5 1.5 0 0 0 2.12-2.12l-2.56-2.56V7.5Z" fill="currentColor"></path></svg></span>
                    <span class="text-gray-500 font-mono font-bold ml-2">{post.data.pubDate ? <FormattedDate date={post.data.pubDate} /> : '未知日期'}</span>
                  </div>
			<h1 class="text-2xl font-bold mb-4">{post.data.title}</h1>
			<div class="semi-divider semi-divider-horizontal semi-divider-with-text semi-divider-with-text-center" style="margin-top: 12px; margin-bottom: 12px;"><span class="semi-divider_inner-text" x-semi-prop="children">X</span></div>
			<div class="prose"><Content /></div>
		</div>
	</div>
</Layout>
