---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
const navdata = [
	{ href: "/", text: "文章" },
	{ href: "/archive", text: "归档" },
];
---

<header class="semi-layout-header sticky top-0 z-50 transition-all">
	<div class="container mx-auto px-4">
		<div class="semi-navigation semi-navigation-horizontal rounded-bl-3xl rounded-br-3xl shadow-md bg-white relative">
			<div class="semi-navigation-inner flex justify-between items-center py-3">
				<!-- Logo 左侧 -->
				<div class="semi-navigation-header-list-outer">
					<div class="semi-navigation-header">
						<a href="/" class="semi-icon" style="font-size: 24px;">{SITE_TITLE}</a>
					</div>
				</div>

				<!-- 手机端菜单按钮 -->
				<button id="menuBtn" class="md:hidden text-xl px-2">☰</button>

				<!-- 导航 → 电脑显示 / 手机隐藏点击显示 -->
				<div id="navMenu" class="semi-navigation-footer hidden md:block absolute md:static top-full left-0 w-full md:w-auto bg-white rounded-b-3xl shadow-md md:shadow-none">
					<div class="semi-navigation-list-wrapper">
						<ul class="semi-navigation-list flex flex-col md:flex-row items-center gap-1 md:gap-4 p-4 md:p-0">
							{navdata.map((item) => (
								<HeaderLink href={item.href} class="semi-navigation-item px-3 py-2 w-full md:w-auto text-center">
									{item.text}
								</HeaderLink>
							))}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</header>

<!-- 手机菜单点击切换 JS -->
<script>
	const btn = document.getElementById('menuBtn');
	const menu = document.getElementById('navMenu');
	btn?.addEventListener('click', () => {
		menu?.classList?.toggle('hidden');
		
	});
</script>